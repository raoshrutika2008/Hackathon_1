<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Spotify – Web Player: Music for everyone</title>
  <link rel="icon" href="https://open.spotifycdn.com/cdn/images/favicon32.8e66b099.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --bg-black: #000000;
      --bg-base: #121212;
      --bg-surface: #181818;
      --bg-elevated: #242424;
      --bg-hover: #2e2e2e;
      --spotify-green: #1ed760;
      --spotify-green-hover: #1fdf64;
      --text-primary: #ffffff;
      --text-secondary: #b3b3b3;
      --text-subdued: #727272;
      --border-subtle: rgba(255, 255, 255, 0.1);
      --player-height: 90px;
      --sidebar-width: 260px;
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-full: 9999px;
      --transition: 0.2s ease;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-black);
      color: var(--text-primary);
      height: 100vh;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }
    /* Scrollbar */
    ::-webkit-scrollbar { width: 12px; }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.25);
      border-radius: var(--radius-full);
      border: 3px solid transparent;
      background-clip: content-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.4); }
    .app-container {
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      grid-template-rows: calc(100vh - var(--player-height)) var(--player-height);
      height: 100vh;
      gap: 8px;
      padding: 8px 8px 0 8px;
      background-color: var(--bg-black);
    }
    /* ==================== SIDEBAR ==================== */
    .sidebar { display: flex; flex-direction: column; gap: 8px; height: 100%; overflow: hidden; }
    .sidebar-box { background-color: var(--bg-base); border-radius: var(--radius-md); padding: 16px; }
    
    .logo {
      display: flex; align-items: center; gap: 10px;
      font-size: 22px; font-weight: 700; color: var(--text-primary);
      margin-bottom: 20px; padding-left: 6px; cursor: pointer;
    }
    .logo i { font-size: 32px; color: var(--text-primary); }
    .nav-links { list-style: none; display: flex; flex-direction: column; gap: 4px; }
    .nav-item {
      display: flex; align-items: center; gap: 16px; padding: 10px 12px;
      border-radius: var(--radius-sm); color: var(--text-secondary);
      font-size: 14px; font-weight: 700; cursor: pointer;
      transition: color var(--transition), background var(--transition);
    }
    .nav-item i { font-size: 20px; width: 24px; text-align: center; }
    .nav-item:hover { color: var(--text-primary); }
    .nav-item.active { color: var(--text-primary); background-color: var(--bg-surface); }
    .library-box { flex: 1; display: flex; flex-direction: column; overflow: hidden; padding: 16px 12px; }
    .library-header { display: flex; justify-content: space-between; align-items: center; padding: 4px 6px 12px 6px; }
    .library-title { display: flex; align-items: center; gap: 12px; color: var(--text-secondary); font-size: 15px; font-weight: 700; cursor: pointer; }
    .library-title:hover { color: var(--text-primary); }
    .library-actions { display: flex; align-items: center; gap: 4px; }
    
    .icon-btn, .library-actions button {
      background: transparent; border: none; color: var(--text-secondary);
      font-size: 16px; width: 32px; height: 32px; border-radius: var(--radius-full);
      display: flex; align-items: center; justify-content: center; cursor: pointer;
      transition: all var(--transition);
    }
    .icon-btn:hover, .library-actions button:hover { color: var(--text-primary); background-color: var(--bg-elevated); }
    .library-tags { display: flex; gap: 8px; margin-bottom: 12px; padding: 0 4px; }
    .pill {
      background-color: var(--bg-elevated); color: var(--text-primary); border: none;
      padding: 6px 14px; border-radius: var(--radius-full); font-size: 13px; font-weight: 600; cursor: pointer;
      transition: all var(--transition);
    }
    .pill:hover { background-color: var(--bg-hover); }
    .pill.active { background-color: var(--text-primary); color: var(--bg-black); }
    .library-items { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
    .library-item {
      display: flex; align-items: center; gap: 12px; padding: 8px;
      border-radius: var(--radius-sm); cursor: pointer; transition: background var(--transition);
    }
    .library-item:hover { background-color: var(--bg-surface); }
    .library-item.active-playlist { background-color: var(--bg-elevated); }
    
    .item-cover {
      width: 48px; height: 48px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;
      font-size: 20px; font-weight: bold; color: white;
    }
    .item-info { display: flex; flex-direction: column; overflow: hidden; }
    .item-title { font-size: 14px; font-weight: 600; color: var(--text-primary); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
    .item-meta { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
    /* ==================== MAIN CONTENT ==================== */
    .main-content {
      background-color: var(--bg-base); border-radius: var(--radius-md);
      height: 100%; overflow-y: auto; position: relative;
      display: flex; flex-direction: column;
    }
    .topbar {
      position: sticky; top: 0; height: 64px; padding: 0 24px;
      display: flex; align-items: center; justify-content: space-between;
      background-color: rgba(18, 18, 18, 0.88); backdrop-filter: blur(14px); z-index: 100;
    }
    .topbar-nav { display: flex; gap: 8px; }
    .nav-arrow-btn {
      width: 32px; height: 32px; border-radius: var(--radius-full);
      background-color: rgba(0, 0, 0, 0.7); border: none; color: var(--text-secondary);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .nav-arrow-btn:hover { color: var(--text-primary); }
    .topbar-search { flex: 0 1 380px; position: relative; display: none; }
    .topbar-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); }
    .topbar-search input {
      width: 100%; height: 42px; background-color: var(--bg-elevated);
      border: 1px solid transparent; border-radius: var(--radius-full);
      padding: 0 40px 0 44px; color: var(--text-primary); font-size: 14px; outline: none;
    }
    .topbar-search input:focus { border-color: var(--text-primary); }
    #search-clear-btn {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: var(--text-secondary); cursor: pointer;
    }
    .topbar-user { display: flex; align-items: center; gap: 14px; }
    .user-avatar {
      width: 34px; height: 34px; border-radius: var(--radius-full);
      background: linear-gradient(135deg, #ff7e5f, #feb47b);
      display: flex; align-items: center; justify-content: center;
      font-weight: bold; color: white; font-size: 13px; cursor: pointer;
    }
    .view-container { padding: 0 24px 32px 24px; flex: 1; }
    .view { display: none; }
    .view.active-view { display: block; animation: fadeIn 0.2s ease-out; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    /* ==================== HOME VIEW ==================== */
    .greeting-section h1 { font-size: 32px; font-weight: 700; margin: 16px 0 20px 0; }
    /* Quick Grid (Top 6 Mixes) */
    .quick-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 12px;
      margin-bottom: 36px;
    }
    .quick-card {
      display: flex; align-items: center; background-color: rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-sm); overflow: hidden; cursor: pointer; position: relative;
      transition: background-color var(--transition);
      height: 64px;
    }
    .quick-card:hover { background-color: rgba(255, 255, 255, 0.2); }
    .quick-card-cover {
      width: 64px; height: 64px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 24px; color: #fff;
    }
    .quick-card .card-name { font-size: 14px; font-weight: 700; padding: 0 14px; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .quick-card .play-btn-circle {
      width: 40px; height: 40px; border-radius: var(--radius-full);
      background-color: var(--spotify-green); color: var(--bg-black); display: flex;
      align-items: center; justify-content: center; position: absolute; right: 12px;
      box-shadow: 0 8px 16px rgba(0,0,0,0.4); opacity: 0; transform: translateY(4px);
      transition: all var(--transition);
    }
    .quick-card:hover .play-btn-circle { opacity: 1; transform: translateY(0); }
    .quick-card .play-btn-circle:hover { background-color: var(--spotify-green-hover); transform: scale(1.08); }
    /* Section & Cards Grid */
    .section-block { margin-bottom: 36px; }
    .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; }
    .section-header h2 { font-size: 22px; font-weight: 700; }
    
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 20px;
    }
    .music-card {
      background-color: var(--bg-surface); padding: 16px; border-radius: var(--radius-md);
      cursor: pointer; transition: background-color var(--transition);
      display: flex; flex-direction: column; position: relative;
    }
    .music-card:hover { background-color: var(--bg-elevated); }
    
    .card-img-wrap {
      position: relative; width: 100%; padding-bottom: 100%;
      border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 14px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .card-cover-art {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center; font-size: 48px; color: white;
    }
    
    .card-play-btn {
      position: absolute; bottom: 8px; right: 8px; width: 46px; height: 46px;
      border-radius: var(--radius-full); background-color: var(--spotify-green); color: var(--bg-black);
      border: none; display: flex; align-items: center; justify-content: center; font-size: 18px;
      opacity: 0; transform: translateY(8px); box-shadow: 0 8px 16px rgba(0,0,0,0.35);
      transition: all var(--transition); cursor: pointer;
    }
    .music-card:hover .card-play-btn { opacity: 1; transform: translateY(0); }
    .card-play-btn:hover { background-color: var(--spotify-green-hover); transform: scale(1.08) !important; }
    
    .music-card .card-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .music-card .card-desc { font-size: 13px; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* ==================== SEARCH VIEW ==================== */
    .categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 20px; }
    .category-card {
      height: 160px; border-radius: var(--radius-md); padding: 16px;
      position: relative; overflow: hidden; cursor: pointer; font-weight: 700; font-size: 20px;
      display: flex; justify-content: space-between;
    }
    .category-card i { font-size: 50px; opacity: 0.3; align-self: flex-end; }
    /* ==================== PLAYLIST DETAIL VIEW ==================== */
    .playlist-header { display: flex; align-items: flex-end; gap: 24px; padding: 24px 0 28px 0; }
    .playlist-cover-large {
      width: 200px; height: 200px; border-radius: var(--radius-sm);
      box-shadow: 0 8px 32px rgba(0,0,0,0.6); overflow: hidden; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 64px; color: white;
    }
    .playlist-meta .type-tag { font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
    .playlist-title-main { font-size: 48px; font-weight: 900; margin: 8px 0 12px 0; line-height: 1.1; }
    .playlist-desc { color: var(--text-secondary); font-size: 14px; margin-bottom: 12px; }
    .playlist-stats { font-size: 14px; color: var(--text-secondary); }
    
    .playlist-action-bar { display: flex; align-items: center; gap: 24px; margin-bottom: 24px; }
    .big-play-btn {
      width: 56px; height: 56px; border-radius: var(--radius-full);
      background-color: var(--spotify-green); border: none; color: var(--bg-black);
      font-size: 22px; display: flex; align-items: center; justify-content: center;
      cursor: pointer; box-shadow: 0 8px 16px rgba(0,0,0,0.35); transition: transform var(--transition);
    }
    .big-play-btn:hover { transform: scale(1.06); background-color: var(--spotify-green-hover); }
    /* Tracklist Table */
    .tracklist-container { display: flex; flex-direction: column; }
    .tracklist-header, .track-row {
      display: grid; grid-template-columns: 40px 4fr 3fr 70px;
      padding: 8px 16px; align-items: center; font-size: 14px; color: var(--text-secondary);
    }
    .tracklist-header { border-bottom: 1px solid var(--border-subtle); text-transform: uppercase; font-size: 12px; margin-bottom: 8px; }
    .track-row { border-radius: var(--radius-sm); cursor: pointer; transition: background-color var(--transition); }
    .track-row:hover { background-color: rgba(255, 255, 255, 0.1); }
    .track-row.active-track { color: var(--spotify-green); }
    .track-row.active-track .track-name { color: var(--spotify-green); }
    .track-title-cell { display: flex; align-items: center; gap: 14px; overflow: hidden; }
    .track-mini-art {
      width: 40px; height: 40px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center; color: white; font-size: 16px; flex-shrink: 0;
    }
    .track-title-meta { display: flex; flex-direction: column; overflow: hidden; }
    .track-name { color: var(--text-primary); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .track-artist { font-size: 13px; color: var(--text-secondary); }
    /* ==================== LYRICS VIEW ==================== */
    .lyrics-container { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
    .lyrics-header { margin-bottom: 36px; }
    .lyrics-header h2 { font-size: 36px; font-weight: 900; }
    .lyrics-header p { color: var(--text-secondary); font-size: 18px; }
    .lyrics-lines { display: flex; flex-direction: column; gap: 24px; }
    .lyric-line {
      font-size: 26px; font-weight: 700; color: rgba(255, 255, 255, 0.3);
      cursor: pointer; transition: all 0.2s ease;
    }
    .lyric-line:hover { color: rgba(255, 255, 255, 0.7); }
    .lyric-line.active { color: #ffffff; transform: scale(1.03); transform-origin: left center; }
    /* ==================== BOTTOM PLAYER BAR ==================== */
    .player-bar {
      grid-column: 1 / -1; background-color: var(--bg-black);
      border-top: 1px solid var(--border-subtle); display: flex;
      align-items: center; justify-content: space-between; padding: 0 16px; z-index: 200;
    }
    .player-left { display: flex; align-items: center; gap: 14px; width: 30%; min-width: 180px; }
    .now-playing-cover {
      width: 56px; height: 56px; border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; color: white; flex-shrink: 0;
    }
    .now-playing-info { display: flex; flex-direction: column; overflow: hidden; }
    .now-playing-title { font-size: 14px; font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .now-playing-artist { font-size: 12px; color: var(--text-secondary); }
    .like-btn { background: none; border: none; color: var(--text-secondary); font-size: 16px; cursor: pointer; margin-left: 8px; transition: all var(--transition); }
    .like-btn:hover { color: var(--text-primary); transform: scale(1.15); }
    .like-btn.liked { color: var(--spotify-green); }
    .player-center { display: flex; flex-direction: column; align-items: center; width: 40%; max-width: 720px; gap: 8px; }
    .playback-controls { display: flex; align-items: center; gap: 20px; }
    .control-btn { background: transparent; border: none; color: var(--text-secondary); font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .control-btn:hover { color: var(--text-primary); }
    .control-btn.active { color: var(--spotify-green); }
    .play-pause-btn { width: 36px; height: 36px; border-radius: var(--radius-full); background-color: var(--text-primary); color: var(--bg-black); font-size: 15px; }
    .play-pause-btn:hover { transform: scale(1.08); }
    .playback-bar { display: flex; align-items: center; gap: 8px; width: 100%; }
    .time-text { font-size: 11px; color: var(--text-secondary); min-width: 32px; text-align: center; }
    .progress-bar-wrapper { flex: 1; height: 12px; display: flex; align-items: center; cursor: pointer; }
    .progress-bar { width: 100%; height: 4px; background-color: rgba(255, 255, 255, 0.3); border-radius: var(--radius-full); position: relative; }
    .progress-fill { height: 100%; width: 0%; background-color: var(--text-primary); border-radius: var(--radius-full); }
    .progress-handle { position: absolute; top: 50%; left: 0%; transform: translate(-50%, -50%); width: 12px; height: 12px; background-color: #ffffff; border-radius: var(--radius-full); display: none; }
    .progress-bar-wrapper:hover .progress-fill { background-color: var(--spotify-green); }
    .progress-bar-wrapper:hover .progress-handle { display: block; }
    .player-right { display: flex; align-items: center; justify-content: flex-end; gap: 16px; width: 30%; }
    .volume-container { display: flex; align-items: center; gap: 8px; width: 120px; }
    .volume-bar-wrapper { flex: 1; height: 12px; display: flex; align-items: center; cursor: pointer; }
    .volume-bar { width: 100%; height: 4px; background-color: rgba(255, 255, 255, 0.3); border-radius: var(--radius-full); }
    .volume-fill { height: 100%; width: 80%; background-color: var(--text-primary); border-radius: var(--radius-full); }
    .volume-bar-wrapper:hover .volume-fill { background-color: var(--spotify-green); }
    /* Modal & Toast */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
    .modal-overlay.active { opacity: 1; pointer-events: all; }
    .modal-card { background: var(--bg-elevated); padding: 24px; border-radius: var(--radius-md); width: 320px; display: flex; flex-direction: column; gap: 16px; }
    .modal-card input { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 10px; color: #fff; outline: none; }
    .modal-card input:focus { border-color: var(--spotify-green); }
    .modal-actions { display: flex; justify-content: flex-end; gap: 12px; }
    .btn { padding: 8px 16px; border-radius: var(--radius-full); border: none; font-weight: 700; cursor: pointer; }
    .btn-primary { background: var(--spotify-green); color: #000; }
    .btn-secondary { background: transparent; color: #fff; }
    .toast {
      position: fixed; bottom: 105px; left: 50%; transform: translateX(-50%) translateY(20px);
      background-color: #2e77d0; color: #ffffff; padding: 10px 20px; border-radius: var(--radius-sm);
      font-size: 14px; font-weight: 600; box-shadow: 0 6px 16px rgba(0,0,0,0.5); opacity: 0;
      pointer-events: none; transition: all 0.2s; z-index: 1000;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    /* Clean mobile / small screen adapt */
    @media (max-width: 600px) {
      .app-container { grid-template-columns: 70px 1fr; }
      .logo span, .nav-item span, .library-title span, .library-tags, .item-info { display: none; }
      .nav-item { justify-content: center; padding: 10px 0; }
    }
  </style>
</head>
<body>
  <div class="app-container">
    <!-- ==================== SIDEBAR ==================== -->
    <aside class="sidebar">
      <div class="sidebar-box">
        <div class="logo" onclick="spotify.switchView('home')">
          <i class="fa-brands fa-spotify"></i>
          <span>Spotify</span>
        </div>
        <ul class="nav-links">
          <li class="nav-item active" data-view="home">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
          </li>
          <li class="nav-item" data-view="search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <span>Search</span>
          </li>
        </ul>
      </div>
      <div class="sidebar-box library-box">
        <div class="library-header">
          <div class="library-title" onclick="spotify.switchView('home')">
            <i class="fa-solid fa-lines-leaning"></i>
            <span>Your Library</span>
          </div>
          <div class="library-actions">
            <button id="create-playlist-btn" title="Create Playlist"><i class="fa-solid fa-plus"></i></button>
            <label for="local-file-input" class="icon-btn" title="Upload MP3 / Audio Files">
              <i class="fa-solid fa-arrow-up-from-bracket"></i>
            </label>
            <input type="file" id="local-file-input" accept="audio/*" multiple style="display:none">
          </div>
        </div>
        <div class="library-tags">
          <button class="pill active">Playlists</button>
          <button class="pill">Artists</button>
        </div>
        <div class="library-items" id="library-items">
          <!-- Dynamic Playlists -->
        </div>
      </div>
    </aside>
    <!-- ==================== MAIN CONTENT ==================== -->
    <main class="main-content">
      <header class="topbar">
        <div class="topbar-nav">
          <button class="nav-arrow-btn" onclick="spotify.switchView('home')"><i class="fa-solid fa-chevron-left"></i></button>
          <button class="nav-arrow-btn" onclick="spotify.switchView('search')"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <div class="topbar-search" id="topbar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="search-input" placeholder="What do you want to play?" autocomplete="off">
          <button id="search-clear-btn" style="display:none"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="topbar-user">
          <button class="pill" style="background:#fff;color:#000;font-weight:700;">Explore Premium</button>
          <div class="user-avatar">SP</div>
        </div>
      </header>
      <div class="view-container">
        <!-- 1. HOME VIEW -->
        <section class="view active-view" id="home-view">
          <div class="greeting-section">
            <h1 id="greeting-text">Good afternoon</h1>
          </div>
          
          <div class="quick-grid" id="quick-grid"></div>
          <div class="section-block">
            <div class="section-header"><h2>Made For You</h2></div>
            <div class="cards-grid" id="made-for-you-grid"></div>
          </div>
