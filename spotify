        lyrics: [
          { time: 0, text: "Deep breath in..." },
          { time: 8, text: "Let the mind unwind..." }
        ]
      }
    ];
    const GENRES = [
      { name: "Pop", color: "#8d67ab", icon: "fa-solid fa-music" },
      { name: "Hip-Hop", color: "#ba5d07", icon: "fa-solid fa-record-vinyl" },
      { name: "Lo-Fi Beats", color: "#e61e32", icon: "fa-solid fa-headphones" },
      { name: "Chill & Relax", color: "#1e3264", icon: "fa-solid fa-couch" },
      { name: "Rock", color: "#e91429", icon: "fa-solid fa-guitar" },
      { name: "Electronic", color: "#006450", icon: "fa-solid fa-wave-square" }
    ];
    class SpotifyEngine {
      constructor() {
        this.audio = document.getElementById("audio-player");
        this.playlist = [...TRACKS];
        this.currentIndex = 0;
        this.isPlaying = false;
        this.isShuffle = false;
        this.repeatMode = 0;
        this.likedSongIds = JSON.parse(localStorage.getItem("sp_liked") || "[1, 2, 3]");
        this.customPlaylists = JSON.parse(localStorage.getItem("sp_playlists") || "[]");
        this.init();
      }
      init() {
        this.renderHome();
        this.renderGenres();
        this.renderLibrary();
        this.bindEvents();
        this.loadTrack(0, false);
      }
      bindEvents() {
        document.querySelectorAll(".nav-item").forEach(item => {
          item.onclick = () => this.switchView(item.dataset.view);
        });
        document.getElementById("play-pause-btn").onclick = () => this.togglePlay();
        document.getElementById("prev-btn").onclick = () => this.prev();
        document.getElementById("next-btn").onclick = () => this.next();
        document.getElementById("shuffle-btn").onclick = () => this.toggleShuffle();
        document.getElementById("repeat-btn").onclick = () => this.toggleRepeat();
        document.getElementById("player-like-btn").onclick = () => this.toggleLike();
        this.audio.ontimeupdate = () => this.onTimeUpdate();
        this.audio.onended = () => this.onEnded();
        this.audio.onerror = () => this.startSynthFallback();
        document.getElementById("progress-wrapper").onclick = (e) => this.seek(e);
        document.getElementById("volume-wrapper").onclick = (e) => this.setVolume(e);
        document.getElementById("volume-icon-btn").onclick = () => this.toggleMute();
        document.getElementById("lyrics-toggle-btn").onclick = () => {
          const isLyrics = document.getElementById("lyrics-view").classList.contains("active-view");
          this.switchView(isLyrics ? "home" : "lyrics");
        };
        const searchInput = document.getElementById("search-input");
        searchInput.oninput = (e) => this.handleSearch(e.target.value);
        document.getElementById("search-clear-btn").onclick = () => {
          searchInput.value = "";
          this.handleSearch("");
        };
        document.getElementById("create-playlist-btn").onclick = () => {
          document.getElementById("playlist-modal").classList.add("active");
          document.getElementById("new-playlist-input").focus();
        };
        document.getElementById("modal-cancel-btn").onclick = () => {
          document.getElementById("playlist-modal").classList.remove("active");
        };
        document.getElementById("modal-save-btn").onclick = () => this.createPlaylist();
        document.getElementById("local-file-input").onchange = (e) => this.loadLocalFiles(e.target.files);
        window.onkeydown = (e) => {
          if (["INPUT", "TEXTAREA"].includes(e.target.tagName)) return;
          if (e.code === "Space") { e.preventDefault(); this.togglePlay(); }
          if (e.key.toLowerCase() === "m") this.toggleMute();
          if (e.key.toLowerCase() === "l") this.toggleLike();
        };
      }
      switchView(viewName) {
        document.querySelectorAll(".view").forEach(v => v.classList.remove("active-view"));
        document.querySelectorAll(".nav-item").forEach(n => n.classList.remove("active"));
        
        const target = document.getElementById(`${viewName}-view`);
        if (target) target.classList.add("active-view");
        
        const activeNav = document.querySelector(`.nav-item[data-view="${viewName}"]`);
        if (activeNav) activeNav.classList.add("active");
        document.getElementById("topbar-search").style.display = (viewName === "search") ? "block" : "none";
        if (viewName === "lyrics") this.renderLyrics();
      }
      renderHome() {
        const hour = new Date().getHours();
        document.getElementById("greeting-text").textContent = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
        const quick = document.getElementById("quick-grid");
        quick.innerHTML = this.playlist.slice(0, 6).map((t, i) => `
          <div class="quick-card" onclick="spotify.playIndex(${i})">
            <div class="quick-card-cover" style="background:${t.gradient}">
              <i class="${t.icon}"></i>
            </div>
            <div class="card-name">${t.title}</div>
            <div class="play-btn-circle"><i class="fa-solid fa-play"></i></div>
          </div>
        `).join("");
        const cards = this.playlist.map((t, i) => `
          <div class="music-card" onclick="spotify.playIndex(${i})">
            <div class="card-img-wrap">
              <div class="card-cover-art" style="background:${t.gradient}">
                <i class="${t.icon}"></i>
              </div>
              <button class="card-play-btn"><i class="fa-solid fa-play"></i></button>
            </div>
            <div class="card-title">${t.title}</div>
            <div class="card-desc">${t.artist} • ${t.album}</div>
          </div>
        `).join("");
        document.getElementById("made-for-you-grid").innerHTML = cards;
        document.getElementById("trending-grid").innerHTML = cards;
      }
      renderGenres() {
        document.getElementById("categories-grid").innerHTML = GENRES.map(g => `
          <div class="category-card" style="background-color:${g.color}">
            <span>${g.name}</span>
            <i class="${g.icon}"></i>
          </div>
        `).join("");
      }
      renderLibrary() {
        const lib = document.getElementById("library-items");
        const custom = this.customPlaylists.map(p => `
          <div class="library-item" onclick="spotify.openPlaylist('${p.id}')">
            <div class="item-cover" style="background:#282828;"><i class="fa-solid fa-music"></i></div>
            <div class="item-info">
              <div class="item-title">${p.name}</div>
              <div class="item-meta">Playlist • ${p.songs.length} songs</div>
            </div>
          </div>
        `).join("");
        lib.innerHTML = `
          <div class="library-item active-playlist" onclick="spotify.openLiked()">
            <div class="item-cover" style="background:linear-gradient(135deg, #450af5, #c4efd9);"><i class="fa-solid fa-heart"></i></div>
            <div class="item-info">
              <div class="item-title">Liked Songs</div>
              <div class="item-meta">Playlist • ${this.likedSongIds.length} songs</div>
            </div>
          </div>
          ${custom}
        `;
      }
      openLiked() {
        const liked = this.playlist.filter(t => this.likedSongIds.includes(t.id));
        this.showPlaylistView("Liked Songs", liked, true);
      }
      showPlaylistView(title, tracks, isLiked = false) {
        this.switchView("playlist");
        document.getElementById("playlist-title-main").textContent = title;
        document.getElementById("playlist-song-count").textContent = `${tracks.length} songs`;
        
        const cover = document.getElementById("playlist-cover-large");
        cover.style.background = isLiked ? "linear-gradient(135deg, #450af5, #c4efd9)" : tracks[0]?.gradient || "#282828";
        cover.innerHTML = isLiked ? `<i class="fa-solid fa-heart"></i>` : `<i class="${tracks[0]?.icon || 'fa-solid fa-music'}"></i>`;
        document.getElementById("tracklist-body").innerHTML = tracks.map((t, i) => `
          <div class="track-row" onclick="spotify.playById(${t.id})">
            <div>${i + 1}</div>
            <div class="track-title-cell">
              <div class="track-mini-art" style="background:${t.gradient}"><i class="${t.icon}"></i></div>
              <div class="track-title-meta">
                <div class="track-name">${t.title}</div>
                <div class="track-artist">${t.artist}</div>
              </div>
            </div>
            <div>${t.album}</div>
            <div>${this.formatTime(t.duration)}</div>
          </div>
        `).join("");
        document.getElementById("playlist-play-btn").onclick = () => {
          if (tracks.length) this.playById(tracks[0].id);
        };
      }
      loadTrack(index, autoPlay = true) {
        if (!this.playlist[index]) return;
        this.currentIndex = index;
        const track = this.playlist[index];
        this.stopSynth();
        this.audio.src = track.url;
        document.getElementById("current-title").textContent = track.title;
        document.getElementById("current-artist").textContent = track.artist;
        const cover = document.getElementById("current-cover");
        cover.style.background = track.gradient;
        cover.innerHTML = `<i class="${track.icon}"></i>`;
        this.updateLikeBtn();
        if (autoPlay) this.play();
        this.renderLyrics();
      }
      play() {
        this.audio.play().then(() => {
          this.isPlaying = true;
          document.getElementById("play-pause-btn").innerHTML = `<i class="fa-solid fa-pause"></i>`;
        }).catch(() => {
          this.startSynthFallback();
        });
      }
      pause() {
        this.audio.pause();
        this.stopSynth();
        this.isPlaying = false;
        document.getElementById("play-pause-btn").innerHTML = `<i class="fa-solid fa-play"></i>`;
      }
      togglePlay() {
        if (this.isPlaying) this.pause();
        else this.play();
      }
      playIndex(i) { this.loadTrack(i, true); }
      playById(id) {
        const idx = this.playlist.findIndex(t => t.id === id);
        if (idx !== -1) this.loadTrack(idx, true);
      }
      next() {
        const nextIdx = this.isShuffle 
          ? Math.floor(Math.random() * this.playlist.length)
          : (this.currentIndex + 1) % this.playlist.length;
        this.loadTrack(nextIdx, true);
      }
      prev() {
        const prevIdx = (this.currentIndex - 1 + this.playlist.length) % this.playlist.length;
        this.loadTrack(prevIdx, true);
      }
      toggleShuffle() {
        this.isShuffle = !this.isShuffle;
        document.getElementById("shuffle-btn").classList.toggle("active", this.isShuffle);
        this.toast(this.isShuffle ? "Shuffle on" : "Shuffle off");
      }
      toggleRepeat() {
        this.repeatMode = (this.repeatMode + 1) % 3;
        const btn = document.getElementById("repeat-btn");
        btn.classList.toggle("active", this.repeatMode > 0);
        this.toast(this.repeatMode === 2 ? "Repeat track" : this.repeatMode === 1 ? "Repeat all" : "Repeat off");
      }
      onEnded() {
        if (this.repeatMode === 2) {
          this.audio.currentTime = 0;
          this.play();
        } else {
          this.next();
        }
      }
      onTimeUpdate() {
        const cur = this.audio.currentTime || 0;
        const dur = this.audio.duration || this.playlist[this.currentIndex].duration || 1;
        const pct = (cur / dur) * 100;
        document.getElementById("current-time").textContent = this.formatTime(cur);
        document.getElementById("total-time").textContent = this.formatTime(dur);
        document.getElementById("progress-fill").style.width = `${pct}%`;
        document.getElementById("progress-handle").style.left = `${pct}%`;
        this.syncLyrics(cur);
      }
      seek(e) {
        const rect = document.getElementById("progress-wrapper").getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        const dur = this.audio.duration || this.playlist[this.currentIndex].duration;
        this.audio.currentTime = pct * dur;
      }
      setVolume(e) {
        const rect = document.getElementById("volume-wrapper").getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        this.audio.volume = pct;
        document.getElementById("volume-fill").style.width = `${pct * 100}%`;
      }
      toggleMute() {
        this.audio.muted = !this.audio.muted;
        document.getElementById("volume-icon").className = this.audio.muted ? "fa-solid fa-volume-xmark" : "fa-solid fa-volume-high";
      }
      toggleLike() {
        const id = this.playlist[this.currentIndex].id;
        if (this.likedSongIds.includes(id)) {
          this.likedSongIds = this.likedSongIds.filter(x => x !== id);
          this.toast("Removed from Liked Songs");
        } else {
          this.likedSongIds.push(id);
          this.toast("Added to Liked Songs");
        }
        localStorage.setItem("sp_liked", JSON.stringify(this.likedSongIds));
        this.updateLikeBtn();
        this.renderLibrary();
      }
      updateLikeBtn() {
        const isLiked = this.likedSongIds.includes(this.playlist[this.currentIndex].id);
        const btn = document.getElementById("player-like-btn");
        btn.classList.toggle("liked", isLiked);
        btn.innerHTML = isLiked ? `<i class="fa-solid fa-heart"></i>` : `<i class="fa-regular fa-heart"></i>`;
      }
      createPlaylist() {
        const input = document.getElementById("new-playlist-input");
        const name = input.value.trim() || `My Playlist #${this.customPlaylists.length + 1}`;
        this.customPlaylists.push({ id: "pl_" + Date.now(), name, songs: [1, 2] });
        localStorage.setItem("sp_playlists", JSON.stringify(this.customPlaylists));
        document.getElementById("playlist-modal").classList.remove("active");
        input.value = "";
        this.renderLibrary();
        this.toast(`Created "${name}"`);
      }
      loadLocalFiles(files) {
        if (!files.length) return;
        Array.from(files).forEach((f, i) => {
          this.playlist.unshift({
            id: Date.now() + i,
            title: f.name.replace(/\.[^/.]+$/, ""),
            artist: "Local Artist",
            album: "My Audio",
            duration: 180,
            gradient: "linear-gradient(135deg, #1e3c72, #2a5298)",
            icon: "fa-solid fa-file-audio",
            url: URL.createObjectURL(f),
            lyrics: [{ time: 0, text: "(Playing Local Audio File)" }]
          });
        });
        this.renderHome();
        this.loadTrack(0, true);
        this.toast(`Loaded ${files.length} audio file(s)`);
      }
      handleSearch(q) {
        const query = q.trim().toLowerCase();
        const results = document.getElementById("search-results-section");
        const categories = document.getElementById("search-categories-section");
        document.getElementById("search-clear-btn").style.display = query ? "block" : "none";
        if (!query) {
          results.style.display = "none";
          categories.style.display = "block";
          return;
        }
        results.style.display = "block";
        categories.style.display = "none";
        const matches = this.playlist.filter(t => t.title.toLowerCase().includes(query) || t.artist.toLowerCase().includes(query));
        document.getElementById("search-tracks-list").innerHTML = matches.map(t => `
          <div class="track-row" onclick="spotify.playById(${t.id})">
            <div><i class="fa-solid fa-play"></i></div>
            <div class="track-title-cell">
              <div class="track-mini-art" style="background:${t.gradient}"><i class="${t.icon}"></i></div>
              <div class="track-title-meta">
                <div class="track-name">${t.title}</div>
                <div class="track-artist">${t.artist}</div>
              </div>
            </div>
            <div>${t.album}</div>
            <div>${this.formatTime(t.duration)}</div>
          </div>
        `).join("") || `<div style="padding:20px;color:var(--text-secondary);">No tracks found</div>`;
      }
      renderLyrics() {
        const track = this.playlist[this.currentIndex];
        document.getElementById("lyrics-song-title").textContent = track.title;
        document.getElementById("lyrics-song-artist").textContent = track.artist;
        document.getElementById("lyrics-lines").innerHTML = (track.lyrics || [{ time: 0, text: "♪ Instrumental ♪" }]).map((l, i) => `
          <div class="lyric-line" id="lyric-${i}" onclick="spotify.audio.currentTime = ${l.time}; spotify.play();">
            ${l.text}
          </div>
        `).join("");
      }
      syncLyrics(currentTime) {
        const lyrics = this.playlist[this.currentIndex].lyrics;
        if (!lyrics) return;
        let active = -1;
        for (let i = 0; i < lyrics.length; i++) {
          if (currentTime >= lyrics[i].time) active = i;
        }
        lyrics.forEach((_, i) => {
          const el = document.getElementById(`lyric-${i}`);
          if (el) el.classList.toggle("active", i === active);
        });
      }
      startSynthFallback() {
        try {
          if (!this.audioCtx) this.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          this.stopSynth();
          const osc = this.audioCtx.createOscillator();
          const gain = this.audioCtx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(320, this.audioCtx.currentTime);
          gain.gain.setValueAtTime(0.08, this.audioCtx.currentTime);
          osc.connect(gain);
          gain.connect(this.audioCtx.destination);
          osc.start();
          this.synthOsc = osc;
          this.isPlaying = true;
          document.getElementById("play-pause-btn").innerHTML = `<i class="fa-solid fa-pause"></i>`;
        } catch(e) {}
      }
      stopSynth() {
        if (this.synthOsc) {
          try { this.synthOsc.stop(); } catch(e){}
          this.synthOsc = null;
        }
      }
      formatTime(s) {
        if (isNaN(s)) return "0:00";
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${m}:${sec < 10 ? '0' : ''}${sec}`;
      }
      toast(msg) {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.classList.add("show");
        clearTimeout(this.toastTimer);
        this.toastTimer = setTimeout(() => t.classList.remove("show"), 2200);
      }
    }
    // Instantly launch
    let spotify;
    document.addEventListener("DOMContentLoaded", () => {
      spotify = new SpotifyEngine();
    });
    // Fallback if already loaded
    if (document.readyState === "complete" || document.readyState === "interactive") {
      if (!spotify) spotify = new SpotifyEngine();
    }
  </script>
</body>